{
  "name": "renovate-mcp",
  "version": "1.4.9",
  "description": "MCP server for designing Renovate configurations interactively.",
  "type": "module",
  "bin": {
    "renovate-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:coverage": "npm run build",
    "test:coverage": "vitest run --coverage",
    "generate:presets": "node scripts/generate-presets.mjs",
    "generate:managers": "node scripts/generate-managers.mjs",
    "generate:migrations": "node scripts/generate-migrations.mjs",
    "sync:jsonata-pin": "node scripts/sync-jsonata-pin.mjs",
    "check:snapshot-versions": "node scripts/check-snapshot-versions.mjs",
    "prepack": "npm run build && node -e \"if (!require('fs').readFileSync('dist/index.js','utf8').startsWith('#!')) { console.error('dist/index.js missing shebang'); process.exit(1); }\" && chmod +x dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "renovate",
    "renovatebot",
    "claude",
    "llm",
    "dependencies"
  ],
  "author": "Timo Hankamer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tibuntu/renovate-mcp.git"
  },
  "homepage": "https://github.com/tibuntu/renovate-mcp#readme",
  "bugs": {
    "url": "https://github.com/tibuntu/renovate-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ignore": "^7.0.5",
    "json5": "^2.2.3",
    "jsonata": "2.2.1",
    "jsonc-parser": "^3.3.1",
    "renovate": "^44.30.4",
    "smol-toml": "^1.6.1",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  },
  "overrides": {
    "fast-uri": "^4.0.0",
    "fast-xml-builder": "^1.1.7",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.0"
  },
  "license": "MIT"
}
